# Tạo API key tại Google AI Studio rồi điền ở máy chủ; không đưa file .env lên GitHub.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
# Danh sách origin frontend, ngăn cách bằng dấu phẩy. Không thêm dấu / cuối URL.
ALLOWED_ORIGINS=http://localhost:5500,https://YOUR-USERNAME.github.io
